# ====================================================
# GUNLINK ENVIRONMENT VARIABLES EXAMPLE
# ====================================================

# ----------------------------------------------------
# BACKEND SERVER ENVIRONMENT VARIABLES (server/.env)
# ----------------------------------------------------

# Server Port & Host Binding
PORT=3001
HOST=0.0.0.0

# Upstash Redis REST API (Realtime Room & Session Cache)
# Get keys at: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Supabase PostgreSQL Database (Leaderboard & Player History)
# Get keys at: https://supabase.com/dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ----------------------------------------------------
# FRONTEND CLIENT ENVIRONMENT VARIABLES (client/.env)
# ----------------------------------------------------

# WebSockets Backend Server Target URL
# For local dev: http://localhost:3001
# For production (Render): https://your-backend.onrender.com
VITE_SERVER_URL=http://localhost:3001
