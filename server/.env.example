# Fastify & Socket.IO Server Configuration
PORT=3001
HOST=0.0.0.0

# Upstash Redis REST API Credentials (Optional - Defaults to local memory store if omitted)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Supabase PostgreSQL Database Credentials (Optional - Defaults to local memory leaderboard if omitted)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
